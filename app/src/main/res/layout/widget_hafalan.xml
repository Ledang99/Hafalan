<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact chrome + auto-sizing KFGQPC Arabic so the ayah fills most of the
  home-screen tile. Size bounds are refreshed in code on resize.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="3dp">

    <!-- Single compact meta line (surah + ayah index). -->
    <TextView
        android:id="@+id/widget_surah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_muted"
        android:textSize="10sp" />

    <!-- Kept for id stability; height collapsed — meta lives in widget_surah. -->
    <TextView
        android:id="@+id/widget_ayah_meta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:textColor="@color/widget_muted"
        android:textSize="1sp" />

    <TextView
        android:id="@+id/widget_ayah_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="56sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="@font/uthmanic_hafs"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="8"
        android:textAlignment="center"
        android:textColor="@color/widget_text"
        android:textDirection="rtl"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:includeFontPadding="false"
        android:text="@string/tap_to_play"
        android:textColor="@color/widget_muted"
        android:textSize="9sp" />
</LinearLayout>
