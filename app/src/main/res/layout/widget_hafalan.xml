<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact chrome + auto-sizing KFGQPC Arabic so the ayah fills most of the
  home-screen tile. Size bounds are refreshed in code on resize.

  Note: android:fontFamily on TextView is preview-only — App Widget hosts
  cannot apply app Typefaces via RemoteViews. HafalanWidgetProvider always
  rasterizes ayah text with bundled uthmanic_hafs into widget_ayah_image.

  Bottom row: far-left Stop cancels counted playback; far-right / ayah area
  Listen starts AyahPlaybackService (same as prior whole-widget tap).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="3dp">

    <!-- Single compact meta line (surah + ayah index). -->
    <TextView
        android:id="@+id/widget_surah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_muted"
        android:textSize="10sp" />

    <!-- Kept for id stability; height collapsed — meta lives in widget_surah. -->
    <TextView
        android:id="@+id/widget_ayah_meta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:textColor="@color/widget_muted"
        android:textSize="1sp" />

    <!-- Ayah shown as ImageView bitmap (bundled KFGQPC); TextView kept for ids/preview. -->
    <FrameLayout
        android:id="@+id/widget_ayah_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/widget_ayah_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="@font/uthmanic_hafs"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="8"
            android:textAlignment="center"
            android:textColor="@color/widget_text"
            android:textDirection="rtl"
            android:textSize="34sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_ayah_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Far left = Stop; far right = Listen (ayah area also listens). -->
    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/playback_stop"
            android:textColor="@color/widget_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/tap_to_play"
            android:textColor="@color/widget_muted"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
